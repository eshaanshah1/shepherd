# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj
*.xcworkspace
DerivedData/
xcuserdata/

# macOS
.DS_Store

# Vendored libghostty (~100MB; regenerate via scripts/build-libghostty.sh)
/vendor
/vendor/*.xcframework
/vendor/libghostty-deps/

# xcodegen-generated (regenerate via `xcodegen generate` in spike/seam1)
spike/seam1/Shepherd-Info.plist
spike/seam1/ShepherdDev-Info.plist
spike/seam1/build/
# Any nested derived-data dir: a -derivedDataPath given relative to the wrong cwd
# creates spike/seam1/spike/seam1/build, which the line above does not cover.
**/build/
.claude/worktrees/

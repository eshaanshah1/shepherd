{
  "name": "shepherd-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shepherd v2 (ADE) monorepo root \u2014 see docs/superpowers/specs/2026-08-06-ade-v2-core-design.md",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=25.2.1 <26",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "postinstall": "node tooling/scripts/fix-node-pty-perms.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "test:count": "node tooling/scripts/test-count.mjs",
    "pty:proof": "node tooling/scripts/pty-proof.mjs",
    "pty:proof:electron": "node tooling/scripts/pty-proof-electron.mjs",
    "smoke": "node tooling/scripts/smoke-m0.mjs",
    "smoke:session": "node tooling/scripts/smoke-session.mjs",
    "smoke:terminal": "node tooling/scripts/smoke-terminal.mjs",
    "smoke:isolation": "node tooling/scripts/smoke-isolation.mjs",
    "smoke:single-instance": "node tooling/scripts/smoke-single-instance.mjs",
    "dev": "pnpm --filter @shepherd/app dev",
    "build": "pnpm --filter @shepherd/app build",
    "smoke:m1": "node tooling/scripts/smoke-m1.mjs",
    "smoke:m2": "node tooling/scripts/smoke-m2.mjs",
    "smoke:m3": "node tooling/scripts/smoke-m3.mjs"
  },
  "dependencies": {
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}

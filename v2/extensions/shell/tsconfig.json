{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `src` rather than `.`: there is no `ui/` half here, because a tree crosses
    // the port as data and needs no React. That is the whole reason this
    // extension is smaller than `scratch`.
    "rootDir": "src",
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/sdk" }]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `src` alone: this extension has no `ui/` half. The pill it describes is
    // drawn by the composer, which belongs to `tasks`.
    "rootDir": "src",
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/sdk" }, { "path": "../tasks" }]
}

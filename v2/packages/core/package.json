{
  "name": "@shepherd/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The kernel: session host, terminal mirror, layout, commands, events. Imports stdlib + node-pty + @xterm/headless + @shepherd/sdk only.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "default": "./src/layout/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@shepherd/sdk": "workspace:*",
    "@xterm/addon-serialize": "catalog:",
    "@xterm/headless": "catalog:",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
